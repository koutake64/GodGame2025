.panel {
    flex-grow: 0;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    font-size: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
}

.header {
    -unity-font-style: bold;
    font-size: 16px;
}

.content {
    font-size: 12px;
    white-space: normal;
}

.hover {
    cursor: link;
}